{
  "name": "agent-tokenwatch",
  "version": "0.2.0",
  "description": "Local, metadata-only token and cost telemetry for Claude Code, Codex CLI, and GitHub Copilot CLI.",
  "type": "module",
  "bin": {
    "tokenwatch": "./bin/tokenwatch.mjs",
    "tokenwatch-codex": "./bin/tokenwatch-codex.mjs"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "docs",
    "examples",
    "README.md",
    "INSTALL.md",
    "LICENSE",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "pretest": "node -e \"require('fs').existsSync('test')||(console.error('tokenwatch: no test/ directory here. The npm package ships without its tests; run them from the repository or the release zip.'),process.exit(1))\"",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "smoke": "node ./scripts/smoke.mjs",
    "smoke:codex": "node ./scripts/smoke-codex.mjs",
    "check": "node --check ./bin/tokenwatch.mjs && node --check ./src/cli.mjs && node --check ./examples/statusline-wrapper.mjs && npm test && npm run smoke",
    "pack:check": "npm pack --dry-run",
    "pack:portable": "node ./scripts/package-portable.mjs",
    "audit": "npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude-code",
    "codex",
    "github-copilot",
    "tokens",
    "prompt-cache",
    "telemetry",
    "cost"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mellicci/agent-tokenwatch.git"
  },
  "homepage": "https://github.com/mellicci/agent-tokenwatch#readme",
  "bugs": {
    "url": "https://github.com/mellicci/agent-tokenwatch/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
